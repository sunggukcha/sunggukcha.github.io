---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ResearchArc from '../components/ResearchArc.astro';
import { featuredExperiences, selectedPublications, talks, cv } from '../data/content';
import { SITE } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy reveal is-visible">
        <div class="eyebrow-row">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Researcher at LG Uplus</span>
          <span class="eyebrow-location">Seoul · KR</span>
        </div>

        <h1>
          Sungguk
          <span>Cha<svg class="name-scribble" viewBox="0 0 300 25" aria-hidden="true"><path d="M3 17C72 3 194 4 295 14"></path><path d="M42 22c62-11 145-12 214-5"></path></svg></span>
        </h1>

        <p class="hero-role">AI researcher working on <em>retrieval</em>, <em>multimodal learning</em>, and <em>agentic systems</em>.</p>
        <p class="hero-thesis">I build systems that find, connect, and reason over evidence across documents and modalities.</p>

        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href="/cv.pdf" target="_blank">Download CV <span aria-hidden="true">↗</span></a>
        </div>

        <div class="hero-links" aria-label="Contact and profiles">
          <a href={`mailto:${SITE.email}`}>Email</a>
          {SITE.socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}
        </div>
      </div>

      <div class="hero-visual reveal is-visible">
        <div class="portrait-frame">
          <img src="/images/me.jpeg" width="1081" height="1440" alt="Sungguk Cha seated in a café" fetchpriority="high" />
          <div class="portrait-wash" aria-hidden="true"></div>
          <div class="portrait-label label-top">
            <span>Current focus</span>
            <strong>Evidence-aware AI</strong>
          </div>
          <div class="portrait-label label-bottom">
            <span>Research path</span>
            <strong>See → Find → Reason</strong>
          </div>
          <svg class="portrait-orbit" viewBox="0 0 530 650" aria-hidden="true">
            <path d="M43 455c37 119 200 174 335 105 134-68 164-247 77-375"></path>
            <circle cx="44" cy="454" r="7"></circle>
            <path class="orbit-dash" d="M453 186c-25-40-61-74-103-96"></path>
          </svg>
        </div>
        <div class="hero-note" aria-hidden="true">
          <span class="note-arrow">↳</span>
          <span>long documents<br />complete evidence<br />reliable actions</span>
        </div>
      </div>
    </div>
  </section>

  <div class="signal-strip" aria-label="Research themes">
    <div class="signal-track">
      <span>INFORMATION RETRIEVAL</span><i>✦</i>
      <span>MULTIMODAL LEARNING</span><i>✦</i>
      <span>RAG SYSTEMS</span><i>✦</i>
      <span>AGENTIC REASONING</span><i>✦</i>
      <span>INFORMATION RETRIEVAL</span><i>✦</i>
      <span>MULTIMODAL LEARNING</span><i>✦</i>
      <span>RAG SYSTEMS</span><i>✦</i>
      <span>AGENTIC REASONING</span><i>✦</i>
    </div>
  </div>

  <section class="section work-section" id="work">
    <div class="shell">
      <SectionHeading
        number="01"
        eyebrow="Selected work"
        title="Research built around a simple question: is the evidence really there?"
        description="Selected work spanning complete-evidence retrieval, efficient representations, reinforcement learning, and grounded multimodal systems."
      />

      <div class="publication-grid">
        {selectedPublications.map((publication, index) => (
          <PublicationCard publication={publication} index={index} />
        ))}
      </div>

      <div class="section-end reveal">
        <a class="text-link" href="/cv/#publications">View all publications <span aria-hidden="true">→</span></a>
        <span>8 papers · 2022—2026</span>
      </div>
    </div>
  </section>

  <section class="section arc-section" id="arc">
    <div class="shell">
      <SectionHeading
        number="02"
        eyebrow="Research arc"
        title="From seeing pixels to reasoning over evidence."
        description="The problems changed, but the thread stayed constant: connect representations to what is actually observable."
      />
      <ResearchArc />
    </div>
  </section>

  <section class="section experience-section" id="experience">
    <div class="shell">
      <SectionHeading
        number="03"
        eyebrow="Experience"
        title="Research that moves between papers, systems, and real constraints."
      />

      <div class="experience-list">
        {featuredExperiences.map((experience, index) => (
          <article class="experience-row reveal">
            <div class="experience-number">{String(index + 1).padStart(2, '0')}</div>
            <div class="experience-company">
              <p>{experience.marker}</p>
              <h3>
                {experience.url ? <a href={experience.url} target="_blank" rel="noreferrer">{experience.company}</a> : experience.company}
              </h3>
            </div>
            <div class="experience-detail">
              <p class="experience-role">{experience.role}</p>
              <p>{experience.summary}</p>
            </div>
            <p class="experience-period">{experience.period}</p>
          </article>
        ))}
      </div>
      <div class="section-end reveal">
        <a class="text-link" href="/cv/#experience">Full experience <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section field-notes-section">
    <div class="shell notes-grid">
      <div>
        <SectionHeading
          number="04"
          eyebrow="Field notes"
          title="Ideas travel further when they are explained clearly."
        />
        <div class="talk-preview">
          {talks.external.slice(0, 3).map((talk) => (
            <article class="talk-preview-row reveal">
              <div>
                <p class="talk-date">{talk.date} · {talk.type}</p>
                <h3>{talk.url ? <a href={talk.url} target="_blank" rel="noreferrer">{talk.title}</a> : talk.title}</h3>
                <p>{talk.event}</p>
              </div>
              {talk.url && <span aria-hidden="true">↗</span>}
            </article>
          ))}
        </div>
        <a class="text-link" href="/talks/">Browse talks & notes <span aria-hidden="true">→</span></a>
      </div>

      <aside class="service-card reveal">
        <div class="service-card-top">
          <span>ACADEMIC SERVICE</span>
          <span class="drawn-star" aria-hidden="true">✳</span>
        </div>
        <h3>Reviewer</h3>
        <ul>
          {cv.service.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section beyond-preview">
    <div class="shell beyond-grid">
      <div class="beyond-copy reveal">
        <p class="section-index"><span>05</span> Beyond research</p>
        <h2>Keeping time,<br /><em>off the clock.</em></h2>
        <p>Before retrieval systems and agent loops, there were drum fills. I played with Crescendo at UNIST and NC of Rock at NCSOFT.</p>
        <a class="button button-primary" href="/beyond/">Listen & look around <span aria-hidden="true">→</span></a>
      </div>
      <div class="beyond-collage reveal">
        <figure class="collage-large">
          <img src="/images/crescendo.jpg" width="3508" height="2480" alt="Crescendo band performing on stage" loading="lazy" />
        </figure>
        <figure class="collage-small">
          <img src="/images/crescendo.jpeg" width="1040" height="1477" alt="Crescendo band group portrait" loading="lazy" />
        </figure>
        <span class="collage-caption">Crescendo · 2016—2019</span>
      </div>
    </div>
  </section>

  <section class="closing-statement">
    <div class="shell reveal">
      <p>Find the evidence.</p>
      <p>Connect the pieces.</p>
      <p><em>Reason with care.</em></p>
      <svg viewBox="0 0 380 36" aria-hidden="true"><path d="M4 25c93-19 239-24 370-10"></path></svg>
    </div>
  </section>
</BaseLayout>
