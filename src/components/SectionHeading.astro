---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { number, eyebrow, title, description } = Astro.props;
---

<div class="section-heading reveal">
  <div class="section-index"><span>{number}</span> {eyebrow}</div>
  <div>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
