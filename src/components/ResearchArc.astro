---
const steps = [
  {
    years: '2016–20',
    title: 'Vision',
    copy: 'Learning spatial representations for recognition, segmentation, and embodied decision-making.',
    code: 'SEE',
  },
  {
    years: '2020–24',
    title: 'Multimodal',
    copy: 'Grounding language in images—and teaching models when visual evidence is not there.',
    code: 'GROUND',
  },
  {
    years: '2024–26',
    title: 'Retrieval',
    copy: 'Finding complete evidence across long, visual documents with efficient representations.',
    code: 'FIND',
  },
  {
    years: 'NOW →',
    title: 'Agents',
    copy: 'Building systems that search, verify, and act over evidence instead of guessing.',
    code: 'REASON',
  },
];
---

<div class="research-arc reveal">
  <div class="arc-line" aria-hidden="true"></div>
  {steps.map((step, index) => (
    <article class="arc-step">
      <div class="arc-node" aria-hidden="true"><span>{index + 1}</span></div>
      <p class="arc-years">{step.years}</p>
      <p class="arc-code">{step.code}</p>
      <h3>{step.title}</h3>
      <p>{step.copy}</p>
    </article>
  ))}
</div>
