---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-kicker">Start a conversation</p>
      <a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    <div class="footer-links" aria-label="Social links">
      {SITE.socials.map((social) => (
        <a href={social.href} target="_blank" rel="noreferrer">{social.label} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
    <div class="footer-meta">
      <span>© {year} Sungguk Cha</span>
      <span>{SITE.location}</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>
