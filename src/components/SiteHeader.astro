---
import { SITE } from '../data/site';

const { pathname } = Astro.url;
const isHome = pathname === '/';
const navItems = [
  { label: 'Work', href: isHome ? '#work' : '/#work' },
  { label: 'Research arc', href: isHome ? '#arc' : '/#arc' },
  { label: 'Experience', href: isHome ? '#experience' : '/#experience' },
  { label: 'Talks', href: '/talks/' },
  { label: 'Beyond', href: '/beyond/' },
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <span class="brand-mark" aria-hidden="true">SC</span>
      <span class="brand-copy">
        <strong>{SITE.name}</strong>
        <small>AI Researcher</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation" data-site-nav>
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={pathname.startsWith(item.href.replace(/\/$/, '')) && !item.href.startsWith('/#') ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="nav-cv" href="/cv/">CV <span aria-hidden="true">↗</span></a>
    </nav>

    <div class="header-tools">
      <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme" data-theme-toggle>
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.2A8.7 8.7 0 0 1 8.8 4a8.8 8.8 0 1 0 11.2 11.2Z"></path>
        </svg>
      </button>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
