---
import type { Publication } from '../data/content';

interface Props {
  publication: Publication;
  index: number;
}

const { publication, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="publication-card reveal" style={`--card-index: ${index}`}>
  <div class="publication-topline">
    <span class="publication-number">{number}</span>
    <span class="publication-label">{publication.label}</span>
    <span class="publication-year">{publication.year}</span>
  </div>

  <div class="publication-body">
    <h3><a href={publication.url} target="_blank" rel="noreferrer">{publication.title}</a></h3>
    <p class="publication-summary">{publication.summary}</p>
    {publication.metric && <p class="publication-metric">{publication.metric}</p>}
  </div>

  <div class="publication-meta">
    <p class="authors">
      {publication.authors.map((author, authorIndex) => (
        <>
          {author.startsWith('Sungguk Cha') ? <strong>{author}</strong> : author}
          {authorIndex < publication.authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
    <p>{publication.venue}</p>
    <ul class="tag-list" aria-label="Research areas">
      {publication.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <a class="card-arrow" href={publication.url} target="_blank" rel="noreferrer" aria-label={`Read ${publication.title}`}>
    <span aria-hidden="true">↗</span>
  </a>
</article>
